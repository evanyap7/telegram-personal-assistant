# Block commits that add secrets (API keys, tokens). Install with: brew install gitleaks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || exit 1
else
  echo "pre-commit: gitleaks not installed, secret scan skipped (brew install gitleaks)" >&2
fi
npm run check
