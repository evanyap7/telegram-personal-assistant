{
  "name": "telegram-personal-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "get-gmail-token": "node scripts/get-gmail-token.mjs",
    "setup-gmail-watch": "node scripts/setup-gmail-watch.mjs",
    "setup-dashboard": "node scripts/setup-sheet-dashboard.mjs",
    "bench:intent": "node --experimental-strip-types --import ./scripts/bench/register.mjs scripts/bench/intent-latency.ts",
    "bench:cost": "node --experimental-strip-types --import ./scripts/bench/register.mjs scripts/bench/model-cost.ts",
    "bench:parallel": "node --experimental-strip-types --import ./scripts/bench/register.mjs scripts/bench/parallel-vs-sequential.ts",
    "bench:all": "npm run bench:intent && npm run bench:cost && npm run bench:parallel"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.58",
    "@ai-sdk/open-responses": "^2.0.36",
    "@ai-sdk/perplexity": "^4.0.36",
    "ai": "^7.0.85",
    "googleapis": "^176.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
